# Click Clack Cash Flow — environment template
# Copy to .env and fill in real values. Never commit .env.

# --- Frontend (Vite) ---
VITE_USE_REAL_PAYMENTS=true
VITE_CASHOUT_SERVER_URL=http://localhost:4000

# Optional Lovable Cloud (demo fallback only)
# VITE_LOVABLE_CLOUD_API_URL=https://api.lovable.cloud
# VITE_LOVABLE_CLOUD_API_KEY=

# --- Cashout server (Node) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
CONNECTED_ACCOUNT_ID=acct_your_stripe_account_id
PORT=4000
LOG_LEVEL=info
USD_API_KEY=usd-access-key-2024
USD_VERIFICATION_ENABLED=true

# Optional: mock email payouts without hitting Stripe
# NODE_ENV=development
# MOCK_MODE=true

# --- Supabase (OPTIONAL — not required for cashout-server.js) ---
# Only needed if you use Supabase edge functions / frontend client
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- OGAds GPT + Sponsored PPC ---
# Set to your live GPT site URL once OGAds assigns a domain (site starts as Draft).
VITE_OGADS_GPT_SITE_URL=https://members.ogads.com/tools/gpt-sites
# VITE_SPONSOR_PPC_URL=https://example.com/sponsor

# --- Stripe Sponsored Placement (live, public payment link) ---
VITE_STRIPE_SPONSOR_PAYMENT_LINK=https://buy.stripe.com/4gM8wPaOE0QE6sO9qPdIA0r
# Product prod_VTlMECsqMN4zN8 / Price price_1USnq7DWu650RN3ogjdn5rNC ($25) / Link plink_1USnqCDWu650RN3oWz9eKgBL
