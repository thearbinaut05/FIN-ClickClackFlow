# This isolated service never automatically loads the repository root .env.
# PLACEHOLDER: The intended Supabase project's HTTPS origin.
AUDIT_SUPABASE_URL=https://REPLACE_ME.supabase.co
# PLACEHOLDER: PUBLIC publishable key or legacy anon key. NEVER service_role.
AUDIT_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
# PLACEHOLDER: UUIDs of existing Supabase Auth admins. Empty is forbidden.
AUDIT_ADMIN_USER_IDS=REPLACE_ME
# PLACEHOLDER: Dedicated READ-ONLY PostgreSQL role connection string.
# Use an existing read-only role; creating a role requires separate approval.
AUDIT_DATABASE_URL=postgresql://REPLACE_ME
# PLACEHOLDER: CA certificate if required by your DB. TLS verification stays on.
AUDIT_DATABASE_CA_PEM=
# Optional provider comparison. Leave empty to display NOT CONFIGURED, not $0.
# PLACEHOLDER: restricted rk_live_... or rk_test_... key with Account+Balance READ.
AUDIT_STRIPE_READ_ONLY_KEY=
# PLACEHOLDER: acct_... matching that key's own platform account.
AUDIT_STRIPE_ACCOUNT_ID=
# Render supplies PORT automatically. Do not hardcode it in the Render service.
PORT=4242
