# PLACEHOLDER: copy to monetization/.env; NEVER commit real credentials.
# Isolated from legacy root .env and the read-only reconciliation service.
MONETIZATION_URL=http://localhost:4243
PORT=4243
HOST=127.0.0.1
# PLACEHOLDER: PLATFORM TEST key; this implementation deliberately blocks live keys.
MONETIZATION_STRIPE_KEY=sk_test_REPLACE_ME
# PLACEHOLDER: new PLATFORM Stripe endpoint/CLI signing secret, NOT the old cashout secret.
MONETIZATION_WEBHOOK_SECRET=whsec_REPLACE_ME
# PLACEHOLDER: a separate CONNECT events endpoint secret for payout lifecycle events.
MONETIZATION_CONNECT_WEBHOOK_SECRET=whsec_REPLACE_ME
# Public project URL already used by the app; use a staging project for tests if possible.
MONETIZATION_SUPABASE_URL=https://tqbybefpnwxukzqkanip.supabase.co
# PLACEHOLDER: public publishable/anon key. NEVER service_role here.
MONETIZATION_SUPABASE_PUBLIC_KEY=REPLACE_ME
# PLACEHOLDER: server-only PostgreSQL connection, role limited to new monetization tables.
MONETIZATION_DATABASE_URL=postgresql://REPLACE_ME
# Optional trusted DB CA PEM; TLS certificate verification remains enabled.
MONETIZATION_DATABASE_CA=
# PLACEHOLDER: comma-separated VERIFIED Supabase Auth administrator UUIDs.
MONETIZATION_ADMIN_IDS=REPLACE_ME
MONETIZATION_COUNTRY=US
# Platform commission: 1000 basis points = 10%; not guaranteed net profit after costs.
MONETIZATION_FEE_BPS=1000
# Test payout requests are OFF by default. Nothing sweeps/transfers money automatically.
MONETIZATION_TEST_PAYOUTS=false
# Optional platform premium billing, OFF until real premium benefits exist.
MONETIZATION_PREMIUM_ENABLED=false
MONETIZATION_PREMIUM_PRICE_ID=
# PLACEHOLDER: optional approved affiliate links; see README for JSON structure.
MONETIZATION_AFFILIATE_LINKS=[]
# Optional first-party partner postback contract, disabled unless both are set.
MONETIZATION_PARTNER_APPROVED=false
MONETIZATION_PARTNER_HMAC_SECRET=
